{
  "name": "@opscore/database",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "node --env-file=../../.env node_modules/.bin/prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:prod": "node --env-file=../../.env node_modules/.bin/prisma migrate deploy --schema=prisma/schema.prisma",
    "db:push": "node --env-file=../../.env node_modules/.bin/prisma db push --schema=prisma/schema.prisma",
    "db:seed": "node --env-file=../../.env node_modules/.bin/tsx prisma/seed.ts",
    "db:studio": "node --env-file=../../.env node_modules/.bin/prisma studio --schema=prisma/schema.prisma",
    "db:reset": "node --env-file=../../.env node_modules/.bin/prisma migrate reset --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.14.0"
  },
  "devDependencies": {
    "@types/node": "20.12.12",
    "prisma": "5.14.0",
    "tsx": "4.11.0",
    "typescript": "5.4.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & Organizations
// ---------------------------------------------------------------------------

model Organization {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String             @unique
  status    String             @default("active") // active | deactivated
  createdAt DateTime           @default(now()) @db.Timestamptz
  updatedAt DateTime           @updatedAt @db.Timestamptz

  members         OrganizationMember[]
  teams           Team[]
  eventTypes      EventType[]
  events          Event[]
  workflows       Workflow[]
  workflowVersions WorkflowVersion[]
  tasks           Task[]
  executions      Execution[]
  metrics         Metric[]
  kpis            KPI[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  idempotencyKeys IdempotencyKey[]
  metricHistory MetricHistory[]

  @@map("organizations")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz

  memberships      OrganizationMember[]
  refreshTokens    RefreshToken[]
  teamMemberships  TeamMember[]
  createdEventTypes  EventType[]        @relation("EventTypeCreatedBy")
  createdWorkflows   Workflow[]         @relation("WorkflowCreatedBy")
  createdWorkflowVersions WorkflowVersion[] @relation("WorkflowVersionCreatedBy")
  taskAssignments   TaskAssignment[] @relation("TaskAssignedBy")
  assignedTasks     TaskAssignment[] @relation("AssignedToUser")
  comments          TaskComment[]
  kpiOwner          KPI[]
  auditLogsAsActor  AuditLog[]
  notifications     Notification[]

  @@index([email])
  @@map("users")
}

model OrganizationMember {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  role           String    // owner | admin | operations_manager | team_lead | member
  status         String    @default("active") // active | invited | suspended
  invitedAt      DateTime? @map("invited_at") @db.Timestamptz
  joinedAt       DateTime? @map("joined_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model RefreshToken {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  tokenHash      String   @unique @map("token_hash")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz
  revoked        Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([tokenHash])
  @@index([userId, organizationId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Teams
// ---------------------------------------------------------------------------

model Team {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  status         String   @default("active") // active | archived
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization     @relation(fields: [organizationId], references: [id])
  members         TeamMember[]
  taskAssignments TaskAssignment[]
  notifications   Notification[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId         String   @map("team_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([teamId, organizationId])
  @@map("team_members")
}

// ---------------------------------------------------------------------------
// Event Hub
// ---------------------------------------------------------------------------

model EventType {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  payloadSchema  Json     @map("payload_schema") // JSON Schema draft-07
  source         String   // api | webhook | scheduled | manual
  status         String   @default("active") @map("status") // active | deprecated
  version        Int      @default(1)
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  creator      User         @relation("EventTypeCreatedBy", fields: [createdBy], references: [id])
  events       Event[]

  @@unique([organizationId, name, version])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("event_types")
}

model Event {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  eventTypeId    String    @map("event_type_id") @db.Uuid
  source         String
  payload        Json
  idempotencyKey String    @map("idempotency_key")
  status         String    @default("received") // received | processed | failed
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz
  processedAt    DateTime? @map("processed_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  eventType    EventType    @relation(fields: [eventTypeId], references: [id])
  executions   Execution[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@index([organizationId, eventTypeId])
  @@index([organizationId, receivedAt])
  @@index([idempotencyKey])
  @@map("events")
}

// ---------------------------------------------------------------------------
// Workflow Engine — versioned JSON model
// ---------------------------------------------------------------------------

model Workflow {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  name             String
  description      String?
  currentVersionId String?   @map("current_version_id") @db.Uuid  // points to published version
  status           String    @default("active")  // active | archived
  createdBy        String    @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  organization    Organization      @relation(fields: [organizationId], references: [id])
  creator         User              @relation("WorkflowCreatedBy", fields: [createdBy], references: [id])
  versions        WorkflowVersion[]
  currentVersion  WorkflowVersion?  @relation("WorkflowCurrentVersion", fields: [currentVersionId], references: [id])
  sourcedTasks    Task[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("workflows")
}

model WorkflowVersion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId     String   @map("workflow_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  version        Int      @default(1)
  definition     Json     // { triggerEventTypeId, rules: [...], actions: [...] }
  status         String   @default("draft")  // draft | published | archived
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  workflow         Workflow    @relation(fields: [workflowId], references: [id])
  creator          User        @relation("WorkflowVersionCreatedBy", fields: [createdBy], references: [id])
  organization     Organization @relation(fields: [organizationId], references: [id])
  executions       Execution[]
  activeForWorkflows Workflow[] @relation("WorkflowCurrentVersion")

  @@unique([workflowId, version])
  @@index([workflowId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("workflow_versions")
}

// ---------------------------------------------------------------------------
// Task Center
// ---------------------------------------------------------------------------

model Task {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  title             String
  description       String?
  priority          String    @default("medium") // low | medium | high | critical
  status            String    @default("pending") // pending | in_progress | completed | cancelled
  dueDate           DateTime? @map("due_date") @db.Timestamptz
  overdue           Boolean   @default(false)
  createdBy         String?   @map("created_by") @db.Uuid  // null if created by workflow
  sourceWorkflowId  String?   @map("source_workflow_id") @db.Uuid
  sourceExecutionId String?   @map("source_execution_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization     @relation(fields: [organizationId], references: [id])
  sourceWorkflow  Workflow?        @relation(fields: [sourceWorkflowId], references: [id])
  assignments     TaskAssignment[]
  comments        TaskComment[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, dueDate])
  @@map("tasks")
}

model TaskAssignment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  assigneeType   String   @map("assignee_type") // user | team
  userId         String?  @map("user_id") @db.Uuid
  teamId         String?  @map("team_id") @db.Uuid
  assignedAt     DateTime @default(now()) @map("assigned_at") @db.Timestamptz
  assignedBy     String?  @map("assigned_by") @db.Uuid

  task       Task  @relation(fields: [taskId], references: [id])
  user       User? @relation("AssignedToUser", fields: [userId], references: [id])
  team       Team? @relation(fields: [teamId], references: [id])
  assignedByUser User? @relation("TaskAssignedBy", fields: [assignedBy], references: [id])

  @@index([taskId])
  @@index([organizationId, userId])
  @@index([organizationId, teamId])
  @@map("task_assignments")
}

model TaskComment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  body           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  task   Task @relation(fields: [taskId], references: [id])
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
  @@index([organizationId])
  @@map("task_comments")
}

// ---------------------------------------------------------------------------
// Execution Engine
// ---------------------------------------------------------------------------

model Execution {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  workflowVersionId String   @map("workflow_version_id") @db.Uuid
  eventId          String    @map("event_id") @db.Uuid
  jobId            String    @map("job_id") // BullMQ job id
  queueName        String    @map("queue_name")
  status           String    @default("queued") // queued | running | completed | failed
  attemptCount     Int       @default(0) @map("attempt_count")
  errorDetail      String?   @map("error_detail")
  startedAt        DateTime? @map("started_at") @db.Timestamptz
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization     Organization    @relation(fields: [organizationId], references: [id])
  workflowVersion  WorkflowVersion @relation(fields: [workflowVersionId], references: [id])
  event            Event           @relation(fields: [eventId], references: [id])

  @@index([organizationId])
  @@index([organizationId, workflowVersionId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([jobId])
  @@map("executions")
}

// ---------------------------------------------------------------------------
// Intelligence
// ---------------------------------------------------------------------------

model Metric {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   // built-in or custom
  metricType     String   @map("metric_type") // count | percentage | duration_minutes
  currentValue   Decimal  @default(0) @map("current_value") @db.Decimal(18, 6)
  computedAt     DateTime @default(now()) @map("computed_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id])
  history      MetricHistory[]
  kpis         KPI[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("metrics")
}

model MetricHistory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  metricId       String   @map("metric_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid

  value          Decimal  @db.Decimal(18, 6)
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  triggeredBy    String?  @map("triggered_by")

  metric       Metric       @relation(fields: [metricId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([metricId])
  @@index([metricId, recordedAt])
  @@index([organizationId, recordedAt])

  @@map("metric_history")
}

model KPI {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  metricId       String   @map("metric_id") @db.Uuid
  operator       String   // > | < | >= | <= | =
  targetValue    Decimal  @map("target_value") @db.Decimal(18, 6)
  ownerUserId    String   @map("owner_user_id") @db.Uuid

  status         String   @default("active")
  lastBreached   Boolean  @default(false) @map("last_breached")

  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  metric       Metric       @relation(fields: [metricId], references: [id])
  owner        User         @relation(fields: [ownerUserId], references: [id])

  @@index([organizationId])
  @@index([metricId])
  @@map("kpis")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  recipientType    String    @map("recipient_type") // user | team
  recipientUserId  String?   @map("recipient_user_id") @db.Uuid
  recipientTeamId  String?   @map("recipient_team_id") @db.Uuid
  message          String
  sourceEntityType String    @map("source_entity_type") // task | execution | kpi | workflow
  sourceEntityId   String    @map("source_entity_id") @db.Uuid
  isRead           Boolean   @default(false) @map("is_read")
  readAt           DateTime? @map("read_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization @relation(fields: [organizationId], references: [id])
  recipientUser  User?        @relation(fields: [recipientUserId], references: [id])
  recipientTeam  Team?        @relation(fields: [recipientTeamId], references: [id])

  @@index([organizationId, recipientUserId])
  @@index([organizationId, recipientTeamId])
  @@index([organizationId, isRead])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Observability
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  entityType     String   @map("entity_type") // organization | user | event | workflow | task | execution | metric | kpi | notification
  entityId       String   @map("entity_id") @db.Uuid
  action         String   // created | updated | deleted | status_changed | login_success | login_failed
  actorType      String   @map("actor_type") // user | system
  actorId        String?  @map("actor_id") @db.Uuid
  beforeState    Json?    @map("before_state")
  afterState     Json?    @map("after_state")
  timestamp      DateTime @default(now()) @db.Timestamptz
  requestId      String?  @map("request_id")

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, actorId])
  @@index([organizationId, timestamp])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Idempotency
// ---------------------------------------------------------------------------

model IdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  status         String   // in_flight | completed
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt      DateTime @map("expires_at") @db.Timestamptz // created_at + 24h

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
  @@index([organizationId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

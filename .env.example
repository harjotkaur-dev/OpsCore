NODE_ENV=development

# Database
DATABASE_URL=postgresql://opscore:opscore_dev@localhost:5432/opscore_dev
TEST_DATABASE_URL=postgresql://opscore:opscore_dev@localhost:5432/opscore_test

# Redis
REDIS_URL=redis://localhost:6379

# JWT Keys (RS256) — generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_WITH_GENERATED_KEY\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_GENERATED_KEY\n-----END PUBLIC KEY-----"

# Cookie signing secret (minimum 32 characters)
COOKIE_SECRET=replace-with-32-char-minimum-secret-here

# CORS
CORS_ORIGIN=http://localhost:5173

# API Server
PORT=3001

# Worker concurrency
WORKER_CONCURRENCY_WORKFLOW=10
WORKER_CONCURRENCY_NOTIFICATIONS=20
WORKER_CONCURRENCY_METRICS=5

# Logging
LOG_LEVEL=info

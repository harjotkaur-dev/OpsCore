{
  "name": "@opscore/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx/esm --watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "node --experimental-vm-modules ../../node_modules/.bin/jest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "9.3.1",
    "@fastify/cors": "9.0.1",
    "@fastify/helmet": "11.1.1",
    "@fastify/rate-limit": "9.1.0",
    "@opscore/config": "*",
    "@opscore/database": "*",
    "@opscore/logger": "*",
    "@opscore/types": "*",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "bcryptjs": "2.4.3",
    "bullmq": "5.7.8",
    "fastify": "4.27.0",
    "ioredis": "5.3.2",
    "jsonwebtoken": "9.0.2",
    "pino": "8.21.0",
    "uuid": "9.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.12.12",
    "@types/uuid": "9.0.8",
    "@vitest/coverage-v8": "^2.1.9",
    "fast-check": "^3.22.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "tsx": "4.11.0",
    "typescript": "5.4.5",
    "vitest": "^2.1.9"
  }
}
